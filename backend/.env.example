PROJECT_NAME="reqlens"
DEBUG=false

# CORS — comma-separated list of allowed origins (default: all)
# CORS__ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --------- Database (Supabase PostgreSQL)
DATABASE__URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5432/mydatabase
DATABASE__DIRECT_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5432/mydatabase

# Supabase example:
# DATABASE__URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.com:6543/postgres
# DATABASE__DIRECT_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Neon example (direct, non-pooled host; asyncpg takes ssl=require, not sslmode):
# DATABASE__URL=postgresql+asyncpg://[USER]:[PASSWORD]@ep-[ID].eu-central-1.aws.neon.tech/neondb?ssl=require
# DATABASE__DIRECT_URL=postgresql+asyncpg://[USER]:[PASSWORD]@ep-[ID].eu-central-1.aws.neon.tech/neondb?ssl=require

# --------- JWT (generate secret with: openssl rand -hex 32)
JWT__SECRET=change-me-to-a-secure-random-string
JWT__ALGORITHM=HS256
JWT__EXPIRE_MINUTES=1440

# --------- AI Provider (OpenRouter)
AI__API_KEY=sk-or-...
AI__BASE_URL=https://openrouter.ai/api/v1
AI__MODEL=openai/gpt-oss-120b:free
